{
    "name": "@imbrace/ui",
    "version": "0.0.165",
    "type": "module",
    "main": "dist/main.js",
    "types": "dist/main.d.ts",
    "files": [
        "dist"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "dev": "vite -c vite.config.playground.ts",
        "build": "tsc --p ./tsconfig-build.json && vite build",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "lint:fix": "eslint --fix lib --ext .ts,.tsx",
        "preview": "vite preview",
        "prepublishOnly": "pnpm build",
        "storybook": "storybook dev -p 6006 --no-open",
        "build-storybook": "storybook build",
        "prepare": "husky install",
        "lint-staged": "lint-staged",
        "build-playground": "vite build -c vite.config.playground.ts",
        "publish:next": "pnpm publish --verbose --no-git-checks --tag next"
    },
    "browserslist": {
        "production": [
            ">0.1%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 15 firefox version",
            "last 5 safari version"
        ]
    },
